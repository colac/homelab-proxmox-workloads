---
# The Proxmox node, for the update procedure only (`mise run update
# nextcloud`): it snapshots this app's VM there, as root, and identifies the
# VM in the node's guest list. Never updated from this repo. Copy to
# proxmox.yml (git-ignored: the address is machine state).
#
# Kept out of inventory/ on purpose: only the update tasks pass this file
# (-i), so no other playbook can ever target the node.
all:
  children:
    proxmox_hosts:
      hosts:
        pve:
          ansible_host: 192.168.1.169
          ansible_user: root
          ansible_become: false
