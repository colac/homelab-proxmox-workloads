---
# ============================================================================
# Reference copy of secrets.yaml (repo root) — plaintext, tracked,
# PLACEHOLDERS ONLY.
#
# This root file holds INFRASTRUCTURE credentials only — what every app's
# Terraform project needs. App secrets live in <app>/secrets.yaml, so a
# Terraform run never sees an app password and an Ansible run never sees the
# Proxmox token.
#
#   mise run secrets:edit      # this file
#   mise run secrets:check     # every file, names only, never values
#
# .mise/sops-exec's `terraform` profile reads it and exports
# TF_VAR_pm_api_url / _token_id / _token_secret, TF_VAR_pm_tls_insecure and,
# if set, TF_TOKEN_app_terraform_io — for one `mise run tf <app> …` command.
# Keep this file's KEYS in sync with secrets.yaml; never put a real value here.
# ============================================================================

# Base API endpoint, no /api2/json suffix — sops-exec appends it.
proxmox_endpoint: "https://pve.example.com:8006"

# terraform@pve token (clone/configure rights). Ideally its own token per repo
# (terraform@pve!terraform-workloads) so revoking one cannot break another —
# see the core repo's terraform/README.md for the pveum commands.
proxmox_terraform_token_id: "terraform@pve!terraform-automation"
proxmox_terraform_token_secret: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# app.terraform.io API token (org colac_homelab). Workspaces run in Local
# execution mode, but state lives in TFC, so `terraform init` needs one.
# Leave empty to fall back to `terraform login` credentials.
tf_cloud_token: ""
